// Prisma schema for the Kraft & Serenade storefront.
//
// The schema is built up section by section as the landing page moves off
// hard-coded content. Right now it only covers the Hero section.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The site colour palette. One row, addressed by the fixed id in lib/theme.ts.
///
/// Each column is one `--color-*` custom property from app/globals.css. The
/// root layout writes them onto `html:root`, which overrides the compiled
/// Tailwind defaults, so changing a value here recolours the whole site.
model Theme {
  id String @id

  /// Surfaces
  canvas     String
  canvasAlt  String
  canvasDeep String

  /// Text
  ink      String
  inkSoft  String
  inkFaint String

  /// Primary
  moss50  String
  moss100 String
  moss400 String
  moss600 String
  moss700 String
  moss900 String

  /// Accent
  blush50  String
  blush100 String
  blush300 String
  blush500 String
  blush600 String

  /// Highlight
  gold String

  updatedAt DateTime @updatedAt

  @@map("theme")
}

/// A bouquet category. Drives the filter rail on /products and, later, the
/// category section on the landing page.
model Category {
  id   String @id @default(uuid())
  /// URL segment, e.g. `rose-bouquets`.
  slug String @unique

  name String
  /// Short form used where space is tight, e.g. filter chips and menus.
  shortName   String
  description String

  imageUrl String
  imageAlt String

  /// Display order, low to high.
  position Int

  products  Product[]
  occasions Occasion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("category")
}

/// An occasion tile in the "Shop by Occasion" section.
///
/// Occasions are a way in rather than a taxonomy: there is no product-to-occasion
/// tagging. Each tile optionally points at a category, which is enough to get the
/// visitor to a relevant listing without a second classification to maintain.
model Occasion {
  id   String @id @default(uuid())
  slug String @unique

  name String
  /// One short line, revealed on hover.
  blurb String

  imageUrl String
  imageAlt String

  /// Display order, low to high.
  position Int

  /// Where the tile leads. Cleared rather than blocking if the category goes
  /// away, in which case the tile falls back to the full catalogue.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("occasion")
}

/// A single bouquet design.
model Product {
  id   String @id @default(uuid())
  slug String @unique

  name        String
  description String

  /// Whole pesos. Bouquets are never priced in centavos, so an integer avoids
  /// the rounding traps that come with floats.
  price Int
  /// Optional "was" price, used to render a strike-through and a savings badge.
  compareAtPrice Int?

  imageUrl String
  imageAlt String

  /// Placeholder social proof until real reviews exist.
  rating      Float
  reviewCount Int

  /// Optional corner label, e.g. "New" or "Best value".
  badge String?

  /// Picked out for the Featured Bouquets section.
  isFeatured Boolean @default(false)

  /// Place in the Best Sellers chart, 1 being top. `null` keeps the product out
  /// of the chart entirely. Not unique, so two products can be reordered without
  /// having to dodge a constraint mid-edit; ties fall back to name order.
  bestSellerRank Int?

  /// Display order within a category listing, low to high.
  position Int

  categoryId String
  /// Restricted rather than cascading: deleting a category that still has
  /// products should fail loudly instead of silently binning the products.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, position])
  @@index([isFeatured])
  @@index([bestSellerRank])
  @@map("product")
}

/// Everything the Hero section renders. There is only ever one row; it is
/// addressed by the fixed id `SINGLETON_ID` in lib/hero.ts.
model HeroSection {
  id String @id

  /// Small pill above the headline.
  eyebrow String

  /// The headline is split so the second half can be italicised separately.
  headingLead    String
  headingAccent  String
  description    String

  primaryCtaLabel   String
  primaryCtaHref    String
  secondaryCtaLabel String
  secondaryCtaHref  String

  /// Full-bleed background photograph.
  backgroundImageUrl String
  backgroundImageAlt String

  /// Social proof block. Avatars are ordered as stored.
  ratingValue      Float
  ratingCaption    String
  reviewAvatarUrls String[]

  /// Floating accent card, shown on xl screens only.
  accentImageUrl String
  accentTitle    String
  accentCaption  String

  trustPoints HeroTrustPoint[]

  updatedAt DateTime @updatedAt

  @@map("hero_section")
}

/// The "Why choose us" section. One row, addressed by a fixed id.
model WhyChooseUsSection {
  id String @id

  eyebrow String
  title   String
  lede    String

  /// Large photograph of the studio.
  primaryImageUrl String
  primaryImageAlt String
  /// Overlapping thumbnail. Decorative, so it has no alt text.
  secondaryImageUrl String

  /// The small badge over the collage, e.g. "6" / "Years on Marigold Lane".
  badgeValue String
  /// Rendered with `whitespace-pre-line`, so newlines here become line breaks.
  badgeLabel String

  points WhyChooseUsPoint[]
  stats  WhyChooseUsStat[]

  updatedAt DateTime @updatedAt

  @@map("why_choose_us_section")
}

/// A check-marked selling point beside the studio photographs.
model WhyChooseUsPoint {
  id    String @id @default(uuid())
  title String
  body  String

  position Int

  sectionId String
  section   WhyChooseUsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("why_choose_us_point")
}

/// One figure in the stat strip below the collage.
model WhyChooseUsStat {
  id String @id @default(uuid())
  /// The figure itself, e.g. "1,240+". Free text, not a number, because these
  /// are written as copy rather than calculated.
  value String
  label String

  position Int

  sectionId String
  section   WhyChooseUsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("why_choose_us_stat")
}

/// The "How it works" section. One row, addressed by a fixed id.
model HowItWorksSection {
  id String @id

  eyebrow String
  title   String
  lede    String

  /// The panel below the steps.
  calloutTitle    String
  calloutBody     String
  calloutCtaLabel String
  calloutCtaHref  String

  steps HowItWorksStep[]

  updatedAt DateTime @updatedAt

  @@map("how_it_works_section")
}

/// A numbered step. The connector line between steps is drawn from position.
model HowItWorksStep {
  id String @id @default(uuid())
  /// Shown inside the circle, e.g. "01". Free text so it can be styled to
  /// taste rather than forced to match the position.
  label String
  title String
  body  String

  position Int

  sectionId String
  section   HowItWorksSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("how_it_works_step")
}

/// The "Customer reviews" section. One row, addressed by a fixed id.
model ReviewsSection {
  id String @id

  eyebrow String
  title   String
  lede    String

  reviews Review[]

  updatedAt DateTime @updatedAt

  @@map("reviews_section")
}

/// A curated customer quote.
///
/// These are testimonials chosen for the landing page, not reviews attached to a
/// product. Real per-product reviews would be a separate table keyed on
/// `Product`, which is also where `Product.rating` would stop being decorative.
model Review {
  id       String @id @default(uuid())
  name     String
  location String
  quote    String

  /// Whole stars, 1 to 5. The card renders them rounded anyway.
  rating Int

  avatarUrl String
  /// What they bought, as free text. Deliberately not a relation: some of these
  /// name a bouquet type rather than a product that still exists.
  purchased String

  position Int

  sectionId String
  section   ReviewsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("review")
}

/// The Instagram-style studio gallery. One row, addressed by a fixed id.
model GallerySection {
  id String @id

  eyebrow String
  title   String
  lede    String

  ctaLabel String
  ctaHref  String

  images GalleryImage[]

  updatedAt DateTime @updatedAt

  @@map("gallery_section")
}

/// One tile in the gallery grid.
model GalleryImage {
  id       String @id @default(uuid())
  imageUrl String
  /// Describes the photo for screen readers.
  alt String
  /// Shown over the tile on hover.
  caption String

  /// Optional destination, e.g. the Instagram post. Tiles without one render as
  /// plain images rather than links that go nowhere.
  linkUrl String?

  position Int

  sectionId String
  section   GallerySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("gallery_image")
}

/// The seasonal promo banner. One row, addressed by a fixed id.
model PromoBannerSection {
  id String @id

  /// Promos are seasonal, so the whole section can be switched off without
  /// deleting the copy that took someone an afternoon to write.
  isPublished Boolean @default(true)

  badge String
  title String
  body  String

  imageUrl String
  imageAlt String

  primaryCtaLabel String
  primaryCtaHref  String
  /// The second button is optional; it renders only when both parts are set.
  secondaryCtaLabel String?
  secondaryCtaHref  String?

  /// The discount code card. A blank `code` hides the card entirely.
  codeLabel String
  code      String?
  codeNote  String

  updatedAt DateTime @updatedAt

  @@map("promo_banner_section")
}

/// Which PSGC level a shipping rate is keyed to.
enum ShippingScope {
  REGION
  CITY
}

enum PaymentMethod {
  /// Admin-uploaded QR code; the customer messages the order number over.
  MANUAL
  /// PayMongo QR Ph.
  PAYMONGO_QRPH
}

enum OrderStatus {
  /// Placed, not yet paid for.
  PENDING_PAYMENT
  PAID
  /// Built and handed to the courier.
  FULFILLED
  CANCELLED
}

/// A placed order.
///
/// Everything about the products is copied onto `OrderItem` rather than read
/// through the relation, so an order is a permanent record of what was bought at
/// what price even after the catalogue changes.
model Order {
  id String @id @default(uuid())

  /// Short and human-readable, e.g. `KS-260805-K7F3`. This is what the customer
  /// quotes to the store, so it is easy to read out and type.
  orderNumber String @unique

  /// Unguessable, and what the confirmation URL uses.
  ///
  /// The order number is deliberately short, which makes it guessable — and the
  /// confirmation page shows a name, phone number and home address. So the page
  /// is keyed on this instead.
  accessToken String @unique

  /// Set when the order was placed while signed in, so it shows up in the
  /// customer's history. Nulled rather than cascading if the account goes away,
  /// because the order is still a record of a sale.
  ///
  /// A guest order stays a guest order: signing up later with the same email does
  /// **not** claim it. Nothing verifies an email address here, so back-linking on
  /// one would let anybody read a stranger's name, phone number and home address
  /// by registering with their email.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Copied onto the order rather than read through the relation, so the details
  /// the courier was given are what the order keeps even if the account is edited.
  customerName  String
  customerEmail String
  customerPhone String

  /// PSGC codes and the names as chosen, so the address stays readable without
  /// calling the API again.
  regionCode   String
  regionName   String
  provinceCode String
  provinceName String
  cityCode     String
  cityName     String
  barangay     String
  street       String
  postalCode   String

  deliveryNotes String?

  /// The day the customer asked for, with no time of day.
  ///
  /// `@db.Date` rather than a timestamp on purpose: a florist delivers on a day,
  /// not at an instant, and storing midnight in some zone invites the value to
  /// shift by one when it is read back somewhere else. The shop runs on Manila
  /// time; see `lib/delivery.ts`.
  ///
  /// Nullable only because orders placed before this existed have no date.
  deliveryDate DateTime? @db.Date

  /// All whole pesos, calculated server-side when the order was placed.
  subtotal    Int
  shippingFee Int
  /// Surcharge for a same-day or next-day delivery date. Zero when not rushed.
  rushFee Int @default(0)
  total   Int

  /// Which rule produced the shipping fee, kept so the admin can see why.
  shippingBasis String
  shippingLabel String

  paymentMethod PaymentMethod
  status        OrderStatus   @default(PENDING_PAYMENT)

  /// PayMongo Payment Intent, when paying by QR Ph. Unique so a webhook can find
  /// exactly one order, and so a retry cannot attach a second intent.
  paymongoPaymentIntentId String? @unique
  /// The payment that settled the intent, recorded from the webhook.
  paymongoPaymentId String?

  /// Base64 data URL from PayMongo, stored so the page does not have to call the
  /// API again on every view. Codes are single-use and short-lived.
  qrCodeImage String?
  qrExpiresAt DateTime?

  paidAt DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId, createdAt])
  /// The florist's other question: what is going out on a given day.
  @@index([deliveryDate])
  @@map("order")
}

/// When the shop delivers, and what a rushed date costs. One row, fixed id.
model DeliverySettings {
  id String @id

  /// Off means no date is asked for at checkout at all, and nothing is charged.
  isEnabled Boolean @default(true)

  /// Whole pesos added when the chosen date falls inside the rush window.
  rushFee Int

  /// How many days ahead still counts as rushed, counting today as 0. `1` means
  /// today and tomorrow are both surcharged, which is the default.
  rushWithinDays Int

  /// Earliest date a customer may pick, as days from today. `0` allows same-day.
  leadTimeDays Int

  /// How far ahead the calendar opens. Stops someone booking a bouquet for 2029.
  maxAdvanceDays Int

  /// Weekdays the shop never delivers, `0` Sunday through `6` Saturday. An array
  /// rather than seven booleans so adding a day is a value change, not a column.
  closedWeekdays Int[]

  overrides DeliveryDateException[]

  updatedAt DateTime @updatedAt

  @@map("delivery_settings")
}

/// One specific date that breaks the weekly pattern.
///
/// Both directions in one table, decided by `isOpen`: a holiday closure and a
/// one-off Sunday opening are the same kind of fact about the same day, and two
/// tables would let a date appear in both and leave the winner undefined.
model DeliveryDateException {
  id String @id @default(uuid())

  /// Date only, for the reason given on `Order.deliveryDate`.
  date DateTime @db.Date

  /// `false` blocks a day that would otherwise be open; `true` opens one that the
  /// weekday rules close.
  isOpen Boolean @default(false)

  /// Shown to nobody but the admin, e.g. "Holy Week" or "fully booked".
  note String?

  settingsId String
  settings   DeliverySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// One ruling per day.
  @@unique([date])
  @@index([settingsId, date])
  @@map("delivery_date_exception")
}

/// Someone who has made an account on the storefront.
///
/// Accounts are optional — guests can order without one. All an account adds is a
/// saved address, an order history, and not having to retype contact details.
///
/// Sign-in accepts **either** the email or the phone number, so both have to be
/// unique. The phone is stored twice: once as the customer typed it, for display,
/// and once normalised to digits, which is the column sign-in looks at. See
/// `normalizePhone` in lib/customer.ts for why.
model Customer {
  id String @id @default(uuid())

  name String
  /// Stored lowercased and trimmed.
  email String @unique

  /// As the customer typed it.
  phone String
  /// Normalised for lookup, e.g. `09171234567`. Never shown.
  phoneKey String @unique

  /// scrypt, stored as `salt:derivedKey` in hex. See lib/password.ts.
  passwordHash String

  sessions  CustomerSession[]
  addresses CustomerAddress[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

/// A signed-in customer browser.
///
/// Same shape as `AdminSession` and for the same reason: the cookie holds a
/// random token and only its SHA-256 hash is stored, so a leaked database dump
/// cannot be replayed as a login.
model CustomerSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([customerId])
  @@map("customer_session")
}

/// A delivery address the customer has kept, so checkout can fill itself in.
///
/// The same PSGC code-and-name pairs as `Order`, for the same reason: the codes
/// resolve the shipping fee and the names keep the address readable without
/// calling the API again.
model CustomerAddress {
  id String @id @default(uuid())

  /// What the customer calls it, e.g. "Home". Optional — the city stands in.
  label String?

  /// Deliberately just an address. There is no recipient name or phone here,
  /// because `Order` has nowhere to put one: it carries a single set of contact
  /// details. Storing a recipient the order cannot express would be a field that
  /// looks meaningful and reaches nothing. Sending to someone else is a recipient
  /// on `Order` first — see ARCHITECTURE.
  regionCode   String
  regionName   String
  provinceCode String
  provinceName String
  cityCode     String
  cityName     String
  barangay     String
  street       String
  postalCode   String

  deliveryNotes String?

  /// The one checkout preselects. A flag on this table rather than a pointer on
  /// `Customer`, so moving the default is one update here and no second write.
  isDefault Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isDefault])
  @@map("customer_address")
}

/// Every webhook PayMongo has delivered, keyed on their event id.
///
/// PayMongo retries a delivery up to 12 times, so the same event will arrive more
/// than once. Inserting the id first and treating a unique violation as "already
/// handled" is what stops an order being marked paid twice.
model WebhookEvent {
  /// PayMongo's event id, e.g. `evt_...`.
  id   String @id
  type String

  receivedAt DateTime @default(now())

  @@map("webhook_event")
}

/// One line of an order, with the product details copied in.
model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nulled rather than blocking if the product is later deleted; the snapshot
  /// below is what the order actually records.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  productSlug String
  imageUrl    String

  /// Whole pesos, as charged at the time.
  unitPrice Int
  quantity  Int
  lineTotal Int

  @@index([orderId])
  @@map("order_item")
}

/// Delivery charging. One row, addressed by a fixed id.
model ShippingSettings {
  id String @id

  /// Off means no delivery charge is added at all.
  isEnabled Boolean @default(true)

  /// Whole pesos, charged when no location rate matches.
  flatRate Int

  rates ShippingRate[]

  updatedAt DateTime @updatedAt

  @@map("shipping_settings")
}

/// A delivery charge for one region or city/municipality.
///
/// Resolution order is city, then region, then the flat rate — see
/// `resolveShippingFee` in lib/shipping.ts.
model ShippingRate {
  id    String        @id @default(uuid())
  scope ShippingScope

  /// PSGC code of the region or city/municipality.
  psgcCode String
  /// Name at the time it was added, so the admin list and past orders stay
  /// readable without calling the PSGC API again.
  label String

  /// Whole pesos.
  fee Int

  settingsId String
  settings   ShippingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([scope, psgcCode])
  @@index([settingsId])
  @@map("shipping_rate")
}

/// Store identity, contact details and payment configuration. One row,
/// addressed by a fixed id.
model StoreSettings {
  id String @id

  storeName String
  tagline   String

  email String
  phone String
  /// Free-form postal address, one line per entry.
  addressLines String[]

  /// Where manual-payment customers send their order number.
  facebookUrl String

  /// QR code the admin uploads for manual payment. Null until one is uploaded,
  /// which is what hides manual payment as an option at checkout.
  manualPaymentQrUrl String?
  /// Shown alongside the QR code and the order number.
  manualPaymentInstructions String

  businessHours BusinessHour[]

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

/// One row of the opening-hours table in the footer.
model BusinessHour {
  id    String @id @default(uuid())
  /// e.g. "Monday – Friday".
  days String
  /// e.g. "8:00 AM – 7:00 PM".
  hours String

  position Int

  storeId String
  store   StoreSettings @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, position])
  @@map("business_hour")
}

/// Someone who can edit the site. Credentials are managed in /admin/store.
model AdminUser {
  id    String @id @default(uuid())
  email String @unique
  /// scrypt, stored as `salt:derivedKey` in hex. See lib/auth.ts.
  passwordHash String

  sessions AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_user")
}

/// A signed-in admin browser.
///
/// The cookie holds a random token; only its SHA-256 hash is stored, so a leaked
/// database dump cannot be replayed as a login.
model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime

  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("admin_session")
}

/// FAQ copy for both the landing section and the dedicated /faqs page, so one
/// admin panel covers both. One row, addressed by a fixed id.
model FaqSection {
  id String @id

  /// Landing page section.
  eyebrow String
  title   String
  lede    String

  /// The "ask us something else" button, shown in both places.
  ctaLabel String
  ctaHref  String

  /// Header of the dedicated /faqs page.
  pageTitle String
  pageLede  String

  faqs Faq[]

  updatedAt DateTime @updatedAt

  @@map("faq_section")
}

/// A single question and answer.
model Faq {
  id       String @id @default(uuid())
  question String
  answer   String

  /// The landing section shows only these; /faqs always shows everything. Lets
  /// the home page stay short without hiding an answer from the site.
  showOnHome Boolean @default(true)

  position Int

  sectionId String
  section   FaqSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("faq")
}

/// An email captured by the newsletter form.
///
/// Nothing consumes these yet: no sending, no confirmation, no unsubscribe. It
/// is a capture table so addresses are not thrown away in the meantime.
model NewsletterSubscriber {
  id String @id @default(uuid())
  /// Stored lowercased and trimmed, and unique so re-subscribing is a no-op.
  email String @unique

  createdAt DateTime @default(now())

  @@map("newsletter_subscriber")
}

/// A single item in the trust bar pinned to the bottom of the Hero.
model HeroTrustPoint {
  id    String @id @default(uuid())
  label String

  /// Key resolved to a glyph in components/sections/Hero.tsx. One of
  /// `leaf`, `truck`, `sparkle`, `peso`.
  icon String

  /// Hidden below the `lg` breakpoint so the bar does not wrap on mobile.
  desktopOnly Boolean @default(false)

  position Int

  heroSectionId String
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@index([heroSectionId, position])
  @@map("hero_trust_point")
}
