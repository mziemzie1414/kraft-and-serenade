// Prisma schema for the Kraft & Serenade storefront.
//
// The schema is built up section by section as the landing page moves off
// hard-coded content. Right now it only covers the Hero section.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The site colour palette. One row, addressed by the fixed id in lib/theme.ts.
///
/// Each column is one `--color-*` custom property from app/globals.css. The
/// root layout writes them onto `html:root`, which overrides the compiled
/// Tailwind defaults, so changing a value here recolours the whole site.
model Theme {
  id String @id

  /// Surfaces
  canvas     String
  canvasAlt  String
  canvasDeep String

  /// Text
  ink      String
  inkSoft  String
  inkFaint String

  /// Primary
  moss50  String
  moss100 String
  moss400 String
  moss600 String
  moss700 String
  moss900 String

  /// Accent
  blush50  String
  blush100 String
  blush300 String
  blush500 String
  blush600 String

  /// Highlight
  gold String

  updatedAt DateTime @updatedAt

  @@map("theme")
}

/// A bouquet category. Drives the filter rail on /products and, later, the
/// category section on the landing page.
model Category {
  id   String @id @default(uuid())
  /// URL segment, e.g. `rose-bouquets`.
  slug String @unique

  name String
  /// Short form used where space is tight, e.g. filter chips and menus.
  shortName   String
  description String

  imageUrl String
  imageAlt String

  /// Display order, low to high.
  position Int

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("category")
}

/// A single bouquet design.
model Product {
  id   String @id @default(uuid())
  slug String @unique

  name        String
  description String

  /// Whole pesos. Bouquets are never priced in centavos, so an integer avoids
  /// the rounding traps that come with floats.
  price Int
  /// Optional "was" price, used to render a strike-through and a savings badge.
  compareAtPrice Int?

  imageUrl String
  imageAlt String

  /// Placeholder social proof until real reviews exist.
  rating      Float
  reviewCount Int

  /// Optional corner label, e.g. "New" or "Best value".
  badge String?

  /// Picked out for the Featured Bouquets section.
  isFeatured Boolean @default(false)

  /// Display order within a category listing, low to high.
  position Int

  categoryId String
  /// Restricted rather than cascading: deleting a category that still has
  /// products should fail loudly instead of silently binning the products.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, position])
  @@index([isFeatured])
  @@map("product")
}

/// Everything the Hero section renders. There is only ever one row; it is
/// addressed by the fixed id `SINGLETON_ID` in lib/hero.ts.
model HeroSection {
  id String @id

  /// Small pill above the headline.
  eyebrow String

  /// The headline is split so the second half can be italicised separately.
  headingLead    String
  headingAccent  String
  description    String

  primaryCtaLabel   String
  primaryCtaHref    String
  secondaryCtaLabel String
  secondaryCtaHref  String

  /// Full-bleed background photograph.
  backgroundImageUrl String
  backgroundImageAlt String

  /// Social proof block. Avatars are ordered as stored.
  ratingValue      Float
  ratingCaption    String
  reviewAvatarUrls String[]

  /// Floating accent card, shown on xl screens only.
  accentImageUrl String
  accentTitle    String
  accentCaption  String

  trustPoints HeroTrustPoint[]

  updatedAt DateTime @updatedAt

  @@map("hero_section")
}

/// A single item in the trust bar pinned to the bottom of the Hero.
model HeroTrustPoint {
  id    String @id @default(uuid())
  label String

  /// Key resolved to a glyph in components/sections/Hero.tsx. One of
  /// `leaf`, `truck`, `sparkle`, `peso`.
  icon String

  /// Hidden below the `lg` breakpoint so the bar does not wrap on mobile.
  desktopOnly Boolean @default(false)

  position Int

  heroSectionId String
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@index([heroSectionId, position])
  @@map("hero_trust_point")
}
